{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeKPro",
  "version": "1.0.0",
  "identifier": "com.aks.mekpro",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MeKPro: Konfigurator Keyboard Mechanical (Pilot: M82XU 5.0)",
        "width": 1340,
        "height": 860,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
